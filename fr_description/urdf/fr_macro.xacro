<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    fr_robot: parametrized description macro for all Fairino cobots,
    following the ur_description design.

    Instead of shipping finished URDFs, one macro generates the kinematic tree
    from per-model parameter files. Link and joint names are constructed with
    tf_prefix, so several robots can coexist in a single URDF/TF tree (dual-arm
    cells), which is impossible with static vendor URDFs.

    Frame chain (all names prefixed with tf_prefix):
      base_link
        |- shoulder_pan_joint -> shoulder_link
        |     |- shoulder_lift_joint -> upper_arm_link
        |           |- elbow_joint -> forearm_link
        |                 |- wrist_1_joint -> wrist_1_link
        |                       |- wrist_2_joint -> wrist_2_link
        |                             |- wrist_3_joint -> wrist_3_link
        |                                   |- flange  (mechanical flange plane, DH d6)
        |                                         |- tool0  (standard tool mounting frame)

    Parameters:
      kinematics_parameters_file  : per-model default_kinematics.yaml (joint origins, axes,
                                    flange_offset)
      joint_limits_parameters_file: per-model joint_limits.yaml
      physical_parameters_file    : per-model physical_parameters.yaml (mass, com, inertia)
      visual_parameters_file      : per-model visual_parameters.yaml (visual/collision meshes)
      parent (optional)     : link to attach the robot to; if set, a fixed joint is
                              created from parent to <tf_prefix>base_link
      origin_xyz/rpy (opt.) : attachment joint origin (only used with parent)
      tf_prefix (optional)  : prefix for all links/joints (e.g. "alice_"), default ""

    Model parameter files are generated by scripts/generate_from_vendor.py from
    the vendored URDFs (see README.md); naming is normalized to ur_description
    conventions (j1..j6 / joint1..joint6 -> semantic joint names,
    uppperarm_link typo and case inconsistencies -> canonical link names).
  -->

  <!-- Internal helper: one arm link (inertial + optional visual/collision) -->
  <xacro:macro name="_fr_link" params="link_name tf_prefix p v c">
    <link name="${tf_prefix}${link_name}">
      <inertial>
        <origin xyz="${p['com']}" rpy="0 0 0"/>
        <mass value="${p['mass']}"/>
        <inertia ixx="${p['inertia']['ixx']}" ixy="${p['inertia']['ixy']}"
                 ixz="${p['inertia']['ixz']}" iyy="${p['inertia']['iyy']}"
                 iyz="${p['inertia']['iyz']}" izz="${p['inertia']['izz']}"/>
      </inertial>
      <xacro:if value="${v['mesh'] is not None}">
        <visual>
          <origin xyz="${v['xyz']}" rpy="${v['rpy']}"/>
          <geometry>
            <mesh filename="${v['mesh']}"/>
          </geometry>
          <material name="">
            <color rgba="${v['rgba']}"/>
          </material>
        </visual>
      </xacro:if>
      <xacro:if value="${c['mesh'] is not None}">
        <collision>
          <origin xyz="${c['xyz']}" rpy="${c['rpy']}"/>
          <geometry>
            <mesh filename="${c['mesh']}"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>
  </xacro:macro>

  <!-- Internal helper: one revolute arm joint -->
  <xacro:macro name="_fr_joint" params="joint_name parent_link child_link tf_prefix kin lim">
    <joint name="${tf_prefix}${joint_name}" type="revolute">
      <origin xyz="${kin['xyz']}" rpy="${kin['rpy']}"/>
      <parent link="${tf_prefix}${parent_link}"/>
      <child link="${tf_prefix}${child_link}"/>
      <axis xyz="${kin['axis']}"/>
      <limit lower="${lim['lower']}" upper="${lim['upper']}"
             effort="${lim['effort']}" velocity="${lim['velocity']}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="fr_robot" params="
      kinematics_parameters_file
      joint_limits_parameters_file
      physical_parameters_file
      visual_parameters_file
      parent:=''
      origin_xyz:='0 0 0'
      origin_rpy:='0 0 0'
      tf_prefix:=''">

    <!-- Load per-model parameter files -->
    <xacro:property name="kinematics"
        value="${xacro.load_yaml(kinematics_parameters_file)['kinematics']}"/>
    <xacro:property name="flange_offset"
        value="${xacro.load_yaml(kinematics_parameters_file)['flange_offset']}"/>
    <xacro:property name="joint_limits"
        value="${xacro.load_yaml(joint_limits_parameters_file)['joint_limits']}"/>
    <xacro:property name="physical"
        value="${xacro.load_yaml(physical_parameters_file)['physical']}"/>
    <xacro:property name="visual"
        value="${xacro.load_yaml(visual_parameters_file)['visual']}"/>
    <xacro:property name="collision"
        value="${xacro.load_yaml(visual_parameters_file)['collision']}"/>

    <!-- Optional fixed attachment to a parent link (e.g. world or a table) -->
    <xacro:if value="${parent != ''}">
      <joint name="${tf_prefix}attachment_joint" type="fixed">
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
        <parent link="${parent}"/>
        <child link="${tf_prefix}base_link"/>
      </joint>
    </xacro:if>

    <!-- Links -->
    <xacro:_fr_link link_name="base_link" tf_prefix="${tf_prefix}"
        p="${physical['base_link']}" v="${visual['base_link']}" c="${collision['base_link']}"/>
    <xacro:_fr_link link_name="shoulder_link" tf_prefix="${tf_prefix}"
        p="${physical['shoulder_link']}" v="${visual['shoulder_link']}" c="${collision['shoulder_link']}"/>
    <xacro:_fr_link link_name="upper_arm_link" tf_prefix="${tf_prefix}"
        p="${physical['upper_arm_link']}" v="${visual['upper_arm_link']}" c="${collision['upper_arm_link']}"/>
    <xacro:_fr_link link_name="forearm_link" tf_prefix="${tf_prefix}"
        p="${physical['forearm_link']}" v="${visual['forearm_link']}" c="${collision['forearm_link']}"/>
    <xacro:_fr_link link_name="wrist_1_link" tf_prefix="${tf_prefix}"
        p="${physical['wrist_1_link']}" v="${visual['wrist_1_link']}" c="${collision['wrist_1_link']}"/>
    <xacro:_fr_link link_name="wrist_2_link" tf_prefix="${tf_prefix}"
        p="${physical['wrist_2_link']}" v="${visual['wrist_2_link']}" c="${collision['wrist_2_link']}"/>
    <xacro:_fr_link link_name="wrist_3_link" tf_prefix="${tf_prefix}"
        p="${physical['wrist_3_link']}" v="${visual['wrist_3_link']}" c="${collision['wrist_3_link']}"/>

    <!-- Joints -->
    <xacro:_fr_joint joint_name="shoulder_pan_joint" parent_link="base_link"
        child_link="shoulder_link" tf_prefix="${tf_prefix}"
        kin="${kinematics['shoulder_pan_joint']}" lim="${joint_limits['shoulder_pan_joint']}"/>
    <xacro:_fr_joint joint_name="shoulder_lift_joint" parent_link="shoulder_link"
        child_link="upper_arm_link" tf_prefix="${tf_prefix}"
        kin="${kinematics['shoulder_lift_joint']}" lim="${joint_limits['shoulder_lift_joint']}"/>
    <xacro:_fr_joint joint_name="elbow_joint" parent_link="upper_arm_link"
        child_link="forearm_link" tf_prefix="${tf_prefix}"
        kin="${kinematics['elbow_joint']}" lim="${joint_limits['elbow_joint']}"/>
    <xacro:_fr_joint joint_name="wrist_1_joint" parent_link="forearm_link"
        child_link="wrist_1_link" tf_prefix="${tf_prefix}"
        kin="${kinematics['wrist_1_joint']}" lim="${joint_limits['wrist_1_joint']}"/>
    <xacro:_fr_joint joint_name="wrist_2_joint" parent_link="wrist_1_link"
        child_link="wrist_2_link" tf_prefix="${tf_prefix}"
        kin="${kinematics['wrist_2_joint']}" lim="${joint_limits['wrist_2_joint']}"/>
    <xacro:_fr_joint joint_name="wrist_3_joint" parent_link="wrist_2_link"
        child_link="wrist_3_link" tf_prefix="${tf_prefix}"
        kin="${kinematics['wrist_3_joint']}" lim="${joint_limits['wrist_3_joint']}"/>

    <!-- Flange and standard tool mounting frame -->
    <link name="${tf_prefix}flange"/>
    <link name="${tf_prefix}tool0"/>
    <joint name="${tf_prefix}wrist_3_link_to_flange" type="fixed">
      <origin xyz="0 0 ${flange_offset}" rpy="0 0 0"/>
      <parent link="${tf_prefix}wrist_3_link"/>
      <child link="${tf_prefix}flange"/>
    </joint>
    <joint name="${tf_prefix}flange_to_tool0" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${tf_prefix}flange"/>
      <child link="${tf_prefix}tool0"/>
    </joint>

  </xacro:macro>
</robot>
