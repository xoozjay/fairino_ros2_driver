<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr_robot">
  <!--
    fr.srdf.xacro: Semantic Robot Description for Fairino robots.
    Supports parameterized model, tf_prefix, and optional end-effector gripper.
  -->
  <xacro:arg name="model" default="fairino5_v6"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="gripper" default="none"/>

  <xacro:property name="model" value="$(arg model)"/>
  <xacro:property name="tf_prefix" value="$(arg tf_prefix)"/>
  <xacro:property name="gripper" value="$(arg gripper)"/>

  <!-- Planning group: arm -->
  <group name="${tf_prefix}arm">
    <chain base_link="${tf_prefix}base_link" tip_link="${tf_prefix}flange"/>
  </group>

  <!-- Named group states -->
  <group_state name="home" group="${tf_prefix}arm">
    <joint name="${tf_prefix}shoulder_pan_joint" value="0.0"/>
    <joint name="${tf_prefix}shoulder_lift_joint" value="-1.5708"/>
    <joint name="${tf_prefix}elbow_joint" value="0.0"/>
    <joint name="${tf_prefix}wrist_1_joint" value="-1.5708"/>
    <joint name="${tf_prefix}wrist_2_joint" value="0.0"/>
    <joint name="${tf_prefix}wrist_3_joint" value="0.0"/>
  </group_state>

  <group_state name="zero" group="${tf_prefix}arm">
    <joint name="${tf_prefix}shoulder_pan_joint" value="0.0"/>
    <joint name="${tf_prefix}shoulder_lift_joint" value="0.0"/>
    <joint name="${tf_prefix}elbow_joint" value="0.0"/>
    <joint name="${tf_prefix}wrist_1_joint" value="0.0"/>
    <joint name="${tf_prefix}wrist_2_joint" value="0.0"/>
    <joint name="${tf_prefix}wrist_3_joint" value="0.0"/>
  </group_state>

  <!-- Model-specific collision disable matrix -->
  <xacro:include filename="$(find fr_moveit_config)/config/${model}/collisions.srdf.xacro"/>
  <xacro:fr_collisions tf_prefix="${tf_prefix}"/>

  <!-- Optional DH-Robotics PGI-140 gripper -->
  <xacro:if value="${gripper == 'pgi140'}">
    <group name="${tf_prefix}gripper">
      <joint name="${tf_prefix}left_finger_joint"/>
    </group>

    <group_state name="open" group="${tf_prefix}gripper">
      <joint name="${tf_prefix}left_finger_joint" value="0.04"/>
    </group_state>

    <group_state name="close" group="${tf_prefix}gripper">
      <joint name="${tf_prefix}left_finger_joint" value="0.0"/>
    </group_state>

    <!-- End-effector attached to flange -->
    <end_effector name="${tf_prefix}gripper" parent_link="${tf_prefix}flange"
                  group="${tf_prefix}gripper" parent_group="${tf_prefix}arm"/>

    <!-- Gripper collision rules (docs/plans/20261013-moveit-config.md):
         1. Fingers overlap at all openings in CAD meshes; disable finger-finger collision checking.
         2. Disable gripper base with adjacent tool/wrist links and gripper fingers.
         3. Collisions between gripper and arm links (forearm, upper_arm, etc.) are kept enabled! -->
    <disable_collisions link1="${tf_prefix}left_finger_link" link2="${tf_prefix}right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="${tf_prefix}gripper_base_link" link2="${tf_prefix}left_finger_link" reason="Adjacent"/>
    <disable_collisions link1="${tf_prefix}gripper_base_link" link2="${tf_prefix}right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="${tf_prefix}gripper_base_link" link2="${tf_prefix}wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="${tf_prefix}gripper_base_link" link2="${tf_prefix}flange" reason="Adjacent"/>
    <disable_collisions link1="${tf_prefix}gripper_base_link" link2="${tf_prefix}tool0" reason="Adjacent"/>
  </xacro:if>

</robot>
