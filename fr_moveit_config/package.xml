<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fr_moveit_config</name>
  <version>0.1.0</version>
  <description>MoveIt 2 configuration and acceptance testing for Fairino robots</description>
  <maintainer email="dev@fairino.local">fairino_ros2_driver contributors</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>ament_index_cpp</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_move_group</depend>
  <depend>moveit_configs_utils</depend>
  <depend>moveit_simple_controller_manager</depend>
  <depend>pilz_industrial_motion_planner</depend>
  <depend>srdfdom</depend>
  <depend>urdf</depend>
  <depend>fr_description</depend>
  <depend>fr_robot_driver</depend>
  <depend>gripper_dahuan_pgi140</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
