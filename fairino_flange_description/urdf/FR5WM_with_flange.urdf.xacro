<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="FR5WM_robot">
  <!-- Vendor URDF remains unchanged; this wrapper appends the nominal DH flange frame. -->
  <xacro:include filename="$(find fairino_description)/urdf/FR5WM.urdf" />
  <link name="gripper_Link" />
  <link name="flange_link" />
  <joint name="wrist3_to_flange" type="fixed">
    <origin xyz="0 0 0.100" rpy="0 0 0" />
    <parent link="wrist3_Link" />
    <child link="flange_link" />
  </joint>
</robot>
