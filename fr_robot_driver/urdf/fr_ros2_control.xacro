<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    fr_ros2_control: ros2_control tag generator for one Fairino robot.

    Joint names are constructed with tf_prefix exactly like in the
    fr_description macro, so the hardware interfaces match the URDF joints.

    NOTE ros2_control conventions (verified against ros2_control 4.48.1 source
    in references/ros2_control):
      - <ros2_control type=...> must be lowercase ("system"); the comparison
        in ResourceManager::load_urdf is case-sensitive, wrong case silently
        skips the component and surfaces as "Wrong state or command interface
        configuration"
      - initial values use the key "initial_value"
      - booleans use hardware_interface::parse_bool ("true"/"True")

    Parameters:
      tf_prefix               : joint-name prefix, must match the fr_robot macro call (default "")
      use_mock_hardware       : use mock_components/GenericSystem instead of real hardware (default true)
      initial_positions_file  : YAML with initial_positions map (unprefixed joint names)
      mock_sensor_commands    : mock GPIO sensor commands (default false)
      gripper                 : none (default) or pgi140: adds the joint <tf_prefix>left_finger_joint
                                (gripper_dahuan_pgi140) with commands position [m], max_effort [N]
                                and states position, velocity
      gripper_index           : real hardware only, the controller's gripper number (default 1)

    Both branches expose the same <gpio name="<tf_prefix>fr_status"> with one state interface,
    fault_class (docs/fault_handling.md section 7), and <gpio name="<tf_prefix>speed_scaling"> with
    speed_scaling_factor, the joint_trajectory_controller's speed scaling (as ur_robot_driver): 1.0,
    and 0.0 on real hardware while the gripper is busy, so a trajectory waits instead of running
    ahead of an arm that cannot move (sdk_quirks G9). With the mock, mock_gpio_commands:=true adds
    command interfaces that loop back into both, to rehearse fault handling and pauses in upper layers.

    Real hardware (fr_robot_driver/FrRobotHardwareInterface) parameters:
      ip                         : controller address (default 192.168.58.2)
      cmd_t_ms / prefill         : ServoJ cmdT in whole ms (default 8) / standing segments at start (3)
      rt_priority                : SCHED_FIFO priority (1-99) of the servo sender thread; 0 = off (default)
      update_rate_hz             : controller_manager update rate; update_rate_hz * cmd_t_ms / 1000
                                   must be an integer >= 1 (default 1000 / cmd_t_ms)
      namespace                  : namespace of the reset_error service node
      allow_unverified_version   : run against a software version that is not whitelisted (default false)
      model                      : fr_description model this URDF was built for (fairino5_v6, ...); the
                                   controller's model string must match it, or configure fails
      kinematics_parameters_file : that model's default_kinematics.yaml; the plugin cross-checks the
                                   state frame's flange_cur_pos against its own FK of the joint angles
      allow_unknown_model, fk_check, fk_position_tolerance_mm, fk_angle_tolerance_deg:
                                   tuning of the two checks, see fr_robot_driver/README.md
  -->
  <!-- Internal helper: one ros2_control joint (name prefixed like the URDF joints).
       Initial values use the "initial_value" key (ros2_control 4.x). -->
  <xacro:macro name="_fr_hw_joint" params="joint_name tf_prefix initial_position">
    <joint name="${tf_prefix}${joint_name}">
      <command_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <!-- Internal helper: the gripper joint, identical for mock and real hardware. The joint limiter
       stays off: it would turn a jump of the opening into a ramp of separate gripper commands; the
       plugin clamps the opening to the stroke itself. -->
  <xacro:macro name="_fr_gripper_joint" params="tf_prefix">
    <joint name="${tf_prefix}left_finger_joint">
      <limits enable="false"/>
      <command_interface name="position">
        <param name="initial_value">0.0</param>
      </command_interface>
      <command_interface name="max_effort">
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <!-- Internal helper: the fr_status gpio, identical for mock and real hardware. -->
  <xacro:macro name="_fr_status_gpio" params="tf_prefix">
    <gpio name="${tf_prefix}fr_status">
      <state_interface name="fault_class"><param name="initial_value">0.0</param></state_interface>
    </gpio>
  </xacro:macro>

  <!-- Internal helper: the speed_scaling gpio, identical for mock and real hardware. -->
  <xacro:macro name="_fr_speed_scaling_gpio" params="tf_prefix">
    <gpio name="${tf_prefix}speed_scaling">
      <state_interface name="speed_scaling_factor"><param name="initial_value">1.0</param></state_interface>
    </gpio>
  </xacro:macro>

  <xacro:macro name="fr_ros2_control" params="
      tf_prefix:=''
      use_mock_hardware:=true
      mock_sensor_commands:='false'
      mock_gpio_commands:='false'
      ip:='192.168.58.2'
      cmd_t_ms:=8
      prefill:=3
      rt_priority:=0
      update_rate_hz:=125
      namespace:=''
      allow_unverified_version:='false'
      model:=''
      kinematics_parameters_file:=''
      allow_unknown_model:='false'
      fk_check:='true'
      fk_position_tolerance_mm:=10.0
      fk_angle_tolerance_deg:=1.0
      gripper:='none'
      gripper_index:=1
      initial_positions_file">

    <xacro:property name="initial_positions"
        value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

    <ros2_control name="${tf_prefix}fr_robot" type="system">

      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${mock_sensor_commands}</param>
          <param name="mock_gpio_commands">${mock_gpio_commands}</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>fr_robot_driver/FrRobotHardwareInterface</plugin>
          <param name="tf_prefix">${tf_prefix}</param>
          <param name="ip">${ip}</param>
          <param name="cmd_t_ms">${cmd_t_ms}</param>
          <param name="prefill">${prefill}</param>
          <param name="rt_priority">${rt_priority}</param>
          <param name="update_rate_hz">${update_rate_hz}</param>
          <param name="namespace">${namespace}</param>
          <param name="allow_unverified_version">${allow_unverified_version}</param>
          <param name="model">${model}</param>
          <param name="allow_unknown_model">${allow_unknown_model}</param>
          <param name="fk_check">${fk_check}</param>
          <param name="fk_position_tolerance_mm">${fk_position_tolerance_mm}</param>
          <param name="fk_angle_tolerance_deg">${fk_angle_tolerance_deg}</param>
          <!-- joint origins "x y z r p y" per joint, in joint order, plus the flange offset -->
          <xacro:property name="kin" value="${xacro.load_yaml(kinematics_parameters_file)}"/>
          <param name="kinematics">${';'.join([kin['kinematics'][j]['xyz'] + ' ' + kin['kinematics'][j]['rpy'] for j in ['shoulder_pan_joint', 'shoulder_lift_joint', 'elbow_joint', 'wrist_1_joint', 'wrist_2_joint', 'wrist_3_joint']])}</param>
          <param name="flange_offset">${kin['flange_offset']}</param>
          <xacro:if value="${gripper != 'none'}">
            <param name="gripper_joint">${tf_prefix}left_finger_joint</param>
            <param name="gripper_index">${gripper_index}</param>
          </xacro:if>
        </xacro:unless>
      </hardware>

      <xacro:_fr_hw_joint joint_name="shoulder_pan_joint" tf_prefix="${tf_prefix}"
          initial_position="${initial_positions['shoulder_pan_joint']}"/>
      <xacro:_fr_hw_joint joint_name="shoulder_lift_joint" tf_prefix="${tf_prefix}"
          initial_position="${initial_positions['shoulder_lift_joint']}"/>
      <xacro:_fr_hw_joint joint_name="elbow_joint" tf_prefix="${tf_prefix}"
          initial_position="${initial_positions['elbow_joint']}"/>
      <xacro:_fr_hw_joint joint_name="wrist_1_joint" tf_prefix="${tf_prefix}"
          initial_position="${initial_positions['wrist_1_joint']}"/>
      <xacro:_fr_hw_joint joint_name="wrist_2_joint" tf_prefix="${tf_prefix}"
          initial_position="${initial_positions['wrist_2_joint']}"/>
      <xacro:_fr_hw_joint joint_name="wrist_3_joint" tf_prefix="${tf_prefix}"
          initial_position="${initial_positions['wrist_3_joint']}"/>

      <xacro:if value="${gripper != 'none'}">
        <xacro:_fr_gripper_joint tf_prefix="${tf_prefix}"/>
      </xacro:if>

      <xacro:_fr_status_gpio tf_prefix="${tf_prefix}"/>
      <xacro:_fr_speed_scaling_gpio tf_prefix="${tf_prefix}"/>

    </ros2_control>
  </xacro:macro>
</robot>
