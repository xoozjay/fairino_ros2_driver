<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr_robot">

  <!--
    fr_controlled.urdf.xacro: description + ros2_control in one document,
    following the my_robot_cell_controlled.urdf.xacro pattern of the UR
    tutorials. This is what the controller_manager consumes.

    Arguments:
      model                  : fr_description model (default fairino5_v6)
      tf_prefix              : link/joint prefix (default "")
      use_mock_hardware      : mock_components/GenericSystem (default true)
      initial_positions_file : ros2_control initial positions
      ip, cmd_t_ms, prefill, rt_priority, update_rate_hz, namespace, allow_unverified_version,
      allow_unknown_model, fk_check, fk_position_tolerance_mm, fk_angle_tolerance_deg:
                             real hardware only, see fr_ros2_control.xacro
      mock_gpio_commands     : mock only, loop-back command interfaces on fr_status/fault_class and speed_scaling/speed_scaling_factor
      gripper                : end effector on tool0: none (default) or pgi140
                               (gripper_dahuan_pgi140, one more joint in ros2_control)
      gripper_index          : real hardware only, the controller's gripper number (default 1)
  -->
  <xacro:arg name="model" default="fairino5_v6"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="initial_positions_file"
             default="$(find fr_robot_driver)/config/initial_positions.yaml"/>
  <xacro:arg name="mock_gpio_commands" default="false"/>
  <xacro:arg name="ip" default="192.168.58.2"/>
  <xacro:arg name="cmd_t_ms" default="8"/>
  <xacro:arg name="prefill" default="3"/>
  <xacro:arg name="rt_priority" default="0"/>
  <xacro:arg name="update_rate_hz" default="125"/>
  <xacro:arg name="namespace" default=""/>
  <xacro:arg name="allow_unverified_version" default="false"/>
  <xacro:arg name="allow_unknown_model" default="false"/>
  <xacro:arg name="fk_check" default="true"/>
  <xacro:arg name="fk_position_tolerance_mm" default="10.0"/>
  <xacro:arg name="fk_angle_tolerance_deg" default="1.0"/>
  <xacro:arg name="gripper" default="none"/>
  <xacro:arg name="gripper_index" default="1"/>

  <xacro:include filename="$(find fr_description)/urdf/fr_macro.xacro"/>
  <xacro:include filename="$(find fr_robot_driver)/urdf/fr_ros2_control.xacro"/>

  <xacro:property name="tf_prefix" value="$(arg tf_prefix)"/>
  <xacro:property name="gripper" value="$(arg gripper)"/>
  <xacro:if value="${gripper not in ['none', 'pgi140']}">
    ${xacro.fatal("gripper must be none or pgi140, not '" + gripper + "'")}
  </xacro:if>

  <xacro:fr_robot
      tf_prefix="${tf_prefix}"
      kinematics_parameters_file="$(find fr_description)/config/$(arg model)/default_kinematics.yaml"
      joint_limits_parameters_file="$(find fr_description)/config/$(arg model)/joint_limits.yaml"
      physical_parameters_file="$(find fr_description)/config/$(arg model)/physical_parameters.yaml"
      visual_parameters_file="$(find fr_description)/config/$(arg model)/visual_parameters.yaml"/>

  <xacro:if value="${gripper == 'pgi140'}">
    <xacro:include filename="$(find gripper_dahuan_pgi140)/urdf/gripper_dahuan_pgi140_macro.xacro"/>
    <xacro:gripper_dahuan_pgi140 tf_prefix="${tf_prefix}" parent="tool0"/>
  </xacro:if>

  <xacro:fr_ros2_control
      tf_prefix="${tf_prefix}"
      gripper="${gripper}"
      gripper_index="$(arg gripper_index)"
      use_mock_hardware="$(arg use_mock_hardware)"
      mock_gpio_commands="$(arg mock_gpio_commands)"
      ip="$(arg ip)"
      cmd_t_ms="$(arg cmd_t_ms)"
      prefill="$(arg prefill)"
      rt_priority="$(arg rt_priority)"
      update_rate_hz="$(arg update_rate_hz)"
      namespace="$(arg namespace)"
      allow_unverified_version="$(arg allow_unverified_version)"
      model="$(arg model)"
      kinematics_parameters_file="$(find fr_description)/config/$(arg model)/default_kinematics.yaml"
      allow_unknown_model="$(arg allow_unknown_model)"
      fk_check="$(arg fk_check)"
      fk_position_tolerance_mm="$(arg fk_position_tolerance_mm)"
      fk_angle_tolerance_deg="$(arg fk_angle_tolerance_deg)"
      initial_positions_file="$(arg initial_positions_file)"/>

</robot>
