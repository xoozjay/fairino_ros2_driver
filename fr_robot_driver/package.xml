<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fr_robot_driver</name>
  <version>1.0.0</version>
  <description>
    ros2_control bringup for Fairino collaborative robots (mock hardware first,
    real hardware plugin to follow). One controller_manager per robot via
    namespace + tf_prefix, enabling multi-robot cells.
  </description>
  <maintainer email="fr@todo.todo">fairino_ros2_driver maintainers</maintainer>
  <license>AGPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_manager</depend>
  <depend>diagnostic_msgs</depend>
  <depend>fr_client_library</depend>
  <depend>fr_description</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_srvs</depend>
  <depend>xacro</depend>

  <!-- mock_components/GenericSystem is provided and exported by hardware_interface/
       ros2_control; both must be installed for mock hardware to load. -->
  <exec_depend>ros2_control</exec_depend>

  <exec_depend>gripper_dahuan_pgi140</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>parallel_gripper_controller</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>lifecycle_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
