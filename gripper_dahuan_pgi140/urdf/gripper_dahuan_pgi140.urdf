<?xml version="1.0"?>
<robot name="gripper_dahuan_pgi140">
  <!--
    Standalone PGI-140-80 parallel gripper model.

    The vendor-independent source model used hand_base_link as the gripper
    root and exposed two prismatic joints. The arm and arm_hand_joint have
    intentionally been removed here so this file can be attached to any
    robot flange with a separate fixed joint.

    Each jaw moves 0.04 m from the closed/reference position. Because the
    two joint frames and axes are mirrored, the maximum total opening is
    0.08 m.
  -->

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0.04 -0.005 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gripper_dahuan_pgi140/collision/hand_base_link.STL" />
      </geometry>
    </visual>
    <collision>
      <!-- The vendor shipped the flexible connector cable as part of the same
           rigid shell, so MoveIt treated the cable as a rigid body and it
           produced false collisions. Use hand_base_link_no_cable.STL for
           collision (rigid base + connector housing only); the visual keeps
           the full vendor mesh including the cable. -->
      <origin xyz="0.04 -0.005 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gripper_dahuan_pgi140/collision/hand_base_link_no_cable.STL" />
      </geometry>
    </collision>
  </link>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gripper_dahuan_pgi140/collision/finger_link1.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gripper_dahuan_pgi140/collision/finger_link1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <origin xyz="0.0345 0 0" rpy="1.5708 0 0" />
    <parent link="gripper_base_link" />
    <child link="left_finger_link" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0.04" effort="40" velocity="1.0" />
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gripper_dahuan_pgi140/collision/finger_link2.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gripper_dahuan_pgi140/collision/finger_link2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <origin xyz="-0.0425 0.0087157 -0.0015" rpy="1.5708 0 3.1416" />
    <parent link="gripper_base_link" />
    <child link="right_finger_link" />
    <axis xyz="1 0 0" />
    <!-- Same positive command as the left jaw; the joint frame is mirrored. -->
    <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0" />
    <limit lower="0" upper="0.04" effort="40" velocity="1.0" />
  </joint>
</robot>
