<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fr_client_library</name>
  <version>0.1.0</version>
  <description>
    Pure C++17 client for the Fairino controller (firmware 3.8.4): state stream,
    XML-RPC and instant-command channels. No ROS runtime dependency.
  </description>
  <maintainer email="fr@todo.todo">fairino_ros2_driver maintainers</maintainer>
  <license>AGPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
